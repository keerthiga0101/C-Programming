#include <stdio.h>

struct ticket {
    int ticket_no;
    char source[20];
    char dest[20];
};

int main() {
    struct ticket t;

    printf("Enter ticket no, source, destination: ");
    scanf("%d %s %s", &t.ticket_no, t.source, t.dest);

    printf("Ticket No: %d\nFrom: %s\nTo: %s",
           t.ticket_no, t.source, t.dest);
    return 0;
}