#include <stdio.h>

struct emp {
    int id;
    char name[20];
};

int main() {
    struct emp e[2] = {{1,"Ravi"}, {2,"Kumar"}};
    int key;

    printf("Enter ID: ");
    scanf("%d", &key);

    for(int i = 0; i < 2; i++)
        if(e[i].id == key)
            printf("Name: %s", e[i].name);

    return 0;
}