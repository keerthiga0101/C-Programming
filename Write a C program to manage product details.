#include <stdio.h>

struct product {
    int id;
    char name[20];
    float price;
};

int main() {
    struct product p;

    printf("Enter product id, name, price: ");
    scanf("%d %s %f", &p.id, p.name, &p.price);

    printf("ID: %d\nName: %s\nPrice: %.2f", p.id, p.name, p.price);
    return 0;
}